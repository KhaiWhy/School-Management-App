# Copy this file to .env.local and fill it in. .env.local is never committed.
# Supabase → Project Settings → API (or the green "Connect" button).

# Used by the app in the browser (safe to be public; RLS protects the data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only (server.mjs, for username sign-in). SECRET: never commit it,
# never put it in a VITE_ variable, never paste it in chat.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
