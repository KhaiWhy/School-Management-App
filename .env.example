# Copy this file to .env.local and fill it in. .env.local is never committed.
# Supabase → Project Settings → API Keys (or the green "Connect" button).
# These are the only two settings the app uses. Both are safe to be public:
# Row Level Security in the database protects the data.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only on your own computer, only for `npm run admin:set-passkey` (never in Render):
# ADMIN_PASSKEY=at-least-16-characters
# SUPABASE_ACCESS_TOKEN=sbp_...   (Supabase → Account → Access Tokens)
